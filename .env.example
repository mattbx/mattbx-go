# Copy to .env (scripts/local.sh does this for you on first run).
# In production these are set with: disco env:set KEY=VALUE

ENV=development
PORT=8080
BASE_URL=http://localhost:8383

# SQLite file. In the container this is /data/app.db (a Disco volume).
DB_PATH=./data/app.db

# Unlocks /admin — full write access to posts and projects.
ADMIN_PASSWORD=changeme-admin

# Unlocks /portfolio — safe to share with recruiters/clients.
PORTFOLIO_PASSWORD=changeme-portfolio

# Signs session cookies. Generate with: openssl rand -hex 32
# scripts/local.sh appends one automatically if this is blank.
SESSION_SECRET=
