package ui

templ About(p Page) {
	@Layout(p) {
		<div class={ classPageHead }>
			<p class={ classEyebrow }>{ SiteRole }</p>
			<h1 class={ classPageTitle }>About</h1>
			<p class={ classPageLede }>{ SiteBio }</p>
		</div>
		<div class="prose">
			<p>
				I am { SiteName }. I design and build digital products — from interfaces
				to the systems behind them.
			</p>
			<p>
				Selected work lives on the{ " " }<a href="/">home page</a>.
				Writing is under{ " " }<a href="/blog">Other</a>.
			</p>
			<p>
				<a href={ templ.SafeURL(SiteContact) }>Get in touch ↗</a>
			</p>
		</div>
	}
}
