package ui

import "github.com/mattbx/mattbx-go/internal/db"

templ BlogIndex(p Page, posts []*db.Post) {
	@Layout(p) {
		<div class={ classPageHead }>
			<p class={ classEyebrow }>{ postCount(len(posts), "post", "posts") }</p>
			<h1 class={ classPageTitleSm }>Posts</h1>
		</div>
		if len(posts) == 0 {
			<p class={ classEmpty }>Nothing published yet.</p>
		} else {
			<ol class="ledger">
				for _, post := range posts {
					@postEntry(post)
				}
			</ol>
		}
	}
}

// One ledger row — whole row is the post link; each cell fills on its own.
templ postEntry(post *db.Post) {
	<li class="entry">
		<a class="entry__link hover-fill-group" href={ templ.SafeURL("/blog/" + post.Slug) }>
			<span class="entry__meta">
				<span class="hover-fill">
					<time datetime={ machineDate(post.Date()) }>{ railDate(post.Date()) }</time>
					if !post.Published {
						{ " " }
						<span class={ classBadge, "text-dim" }>draft</span>
					}
				</span>
			</span>
			<h2 class="entry__title">
				<span class="hover-fill">{ DisplayTitle(post) }</span>
			</h2>
			<span class="entry__date">
				<span class="hover-fill">{ post.Date().Year() }</span>
			</span>
		</a>
	</li>
}

templ BlogPost(p Page, post *db.Post) {
	@Layout(p) {
		<article class="leaf">
			<aside class="rail">
				<span class="rail__line">
					<span class="rail__key">Published</span>
					<time class="rail__value" datetime={ machineDate(post.Date()) }>
						{ railDate(post.Date()) }
					</time>
				</span>
				<span class="rail__line">
					<span class="rail__key">Read</span>
					<span class="rail__value">{ readingTime(post.BodyMD) }</span>
				</span>
				if len(post.TagList()) > 0 {
					<div class="rail__rule"></div>
					<span class="rail__key">Tags</span>
					<span class="rail__tags">
						for _, tag := range post.TagList() {
							<span class="rail__tag">{ tag }</span>
						}
					</span>
				}
				if !post.Published {
					<div class="rail__rule"></div>
					<span class={ classBadge, "text-dim" }>draft</span>
				}
				if p.IsAdmin {
					<div class="rail__rule"></div>
					<a href={ templ.SafeURL(editPostPath(post.ID)) }>Edit</a>
				}
			</aside>
			<div>
				<header class={ classPageHead }>
					if post.Title != "" {
						<h1 class={ classPageTitle }>{ post.Title }</h1>
					}
					if post.Summary != "" {
						<p class={ classPageLede }>{ post.Summary }</p>
					}
				</header>
				<div class="prose">
					@templ.Raw(post.BodyHTML)
				</div>
			</div>
		</article>
	}
}
