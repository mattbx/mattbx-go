package ui

import "github.com/mattbx/mattbx-go/internal/db"

templ Home(p Page, posts []*db.Post) {
	@Layout(p) {
		<div class={ classPageHead }>
			// <p class={ classEyebrow }>{ SiteRole }</p>
			<h1 class="font-mono font-normal text-display mbe-0 tracking-wide uppercase text-fg">{ SiteName }</h1>
			<p class="mt-2 font-mono uppercase tracking-wide text-fg text-display max-w-2/3 leading-tight">{ SiteTagline }</p>
		</div>
		if len(posts) > 0 {
			<section aria-labelledby="recent">
				<div class={ classSectionHead }>
					<h2 class={ classPageTitleSm } id="recent">Latest</h2>
				</div>
				<ol class="ledger">
					for _, post := range posts {
						@postEntry(post)
					}
				</ol>
			</section>
		}
	}
}
