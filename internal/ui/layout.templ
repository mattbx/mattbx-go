package ui

import "github.com/mattbx/mattbx-go/internal/ui/static"

// Layout is the site shell. The profile column sits beside the primary
// column so header/main/footer widths fluidly shrink when it opens.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ p.ThemeAttr() } class={ profileClass(p) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.DocumentTitle() }</title>
			if p.Description != "" {
				<meta name="description" content={ p.Description }/>
				<meta property="og:description" content={ p.Description }/>
			}
			<meta property="og:title" content={ p.DocumentTitle() }/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content={ p.CanonicalURL() }/>
			<link rel="canonical" href={ templ.SafeURL(p.CanonicalURL()) }/>
			<link rel="alternate" type="application/rss+xml" title={ SiteName } href="/feed.xml"/>
			<link rel="alternate" type="application/feed+json" title={ SiteName } href="/feed.json"/>
			<link rel="micropub" href={ templ.SafeURL(p.BaseURL + "/micropub") }/>
			<link rel="icon" href={ static.URL("favicon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ static.URL("main.css") }/>
			<link rel="stylesheet" href={ static.URL("chroma.css") }/>
			<link rel="stylesheet" href={ static.URL("tailwind.css") }/>
			<script src={ static.URL("terminal.js") } defer></script>
			<script src={ static.URL("cursor.js") } defer></script>
		</head>
		<body class={ bodyClass(p) }>
			<canvas class="grain" aria-hidden="true"></canvas>
			<a class={ classSkipLink } href="#main">Skip to content</a>
			if p.IsAdmin {
				@adminBar()
			}
			<div class="shell">
				<div class="shell__primary">
					<header class="site-header">
						<div class="site-header__inner">
							<a class="wordmark font-mono text-nav uppercase tracking-normal font-bold text-navigation no-underline" href="/">{ SiteMark }</a>
							<div class="site-header__end">
								<div class="site-header__clock hidden md:block">@MetaClock()</div>
								<nav class="nav font-mono uppercase text-nav text-navigation flex gap-24" aria-label="Primary">
									<a class="nav-item" data-scramble="link" href="/work" { current(p.Nav == "work")... }>Work</a>
									<a class="nav-item" data-scramble="link" href="/blog" { current(p.Nav == "other" || p.Nav == "blog")... }>Other</a>
									@profileNavItem(p)
								</nav>
							</div>
						</div>
					</header>
					<div class="shell__scroll">
						<main class="shell__main" id="main">
							{ children... }
						</main>
					</div>
					<footer class="site-footer font-mono uppercase text-meta">
						<span>© { p.Year() } { SiteName }</span>
						<span class="site-footer__themes" data-theme-switcher aria-label="Theme">
							for _, t := range themeOptions() {
								<button
									type="button"
									class="theme-swatch"
									data-theme-set={ t }
									aria-pressed={ themePressed(p, t) }
									title={ t }
								></button>
							}
						</span>
						<span>{ SiteMark }</span>
					</footer>
				</div>
				<aside
					class="profile-panel"
					id="profile-panel"
					aria-label="Profile"
					{ profilePanelAttrs(p)... }
				>
					@ProfilePanel(p)
				</aside>
			</div>
		</body>
	</html>
}

templ ProfilePanel(p Page) {
	<div class="profile-panel__chrome">
		<button
			type="button"
			class="profile-control profile-control--close nav-item font-mono text-nav uppercase tracking-normal text-navigation bg-transparent border-0 cursor-pointer p-0"
			data-profile-toggle
			data-scramble="link"
			aria-controls="profile-panel"
			aria-expanded={ profileExpanded(p) }
		>
			<span data-label data-profile-label>Profile</span>
			<span class="profile-control__chevron" aria-hidden="true">@IconArrowRightMicro()</span>
		</button>
	</div>
	<div class="profile-panel__body font-mono text-body text-dim">
		@ProfileBody()
	</div>
}

// ProfileBody is the resume itself: intro, links, then one block per
// section of content/profile.md. Shared by the drawer and /profile.
templ ProfileBody() {
	<div class="profile-panel__intro">
		<div class="profile-panel__intro-text">
			@templ.Raw(loadProfile().IntroHTML)
		</div>
		<p class="profile-panel__links m-0">
			<a class="hover-underline" href={ templ.SafeURL(SiteContact) }>Get in touch ↗</a>
			<a class="hover-underline" href={ templ.SafeURL(SiteLinkedIn) } rel="noopener noreferrer" target="_blank">LinkedIn ↗</a>
			<a class="hover-underline" href={ templ.SafeURL(SiteGitHub) } rel="noopener noreferrer" target="_blank">GitHub ↗</a>
		</p>
	</div>
	for i, section := range loadProfile().Sections {
		<section class="profile-panel__section" aria-labelledby={ profileSectionID(i) }>
			<h2 class="profile-panel__heading" id={ profileSectionID(i) }>{ section.Title }</h2>
			@templ.Raw(section.HTML)
		</section>
	}
}

// profileNavItem links to /profile. On desktop terminal.js turns the click
// into a drawer toggle and adds aria-expanded/aria-controls; below 64rem, or
// without JS, it navigates. On /profile itself it's a plain current link.
templ profileNavItem(p Page) {
	if p.Nav == "profile" {
		<a class="nav-item" data-scramble="link" href="/profile" aria-current="page">Profile</a>
	} else {
		<a
			class="profile-control profile-control--launch nav-item"
			data-profile-toggle
			data-scramble="link"
			href="/profile"
		>
			<span class="profile-control__chevron" aria-hidden="true">@IconArrowLeftMicro()</span>
			<span data-label data-profile-label>Profile</span>
		</a>
	}
}

// Admin write-access bar.
templ adminBar() {
	<div class="admin-bar font-mono text-meta bg-surface border-b border-line py-2">
		<div class="w-full px-gutter flex flex-wrap items-center gap-6">
			<a href="/admin">Admin</a>
			<a href="/admin/posts/new">New post</a>
			<a href="/admin/projects/new">New project</a>
			<form class="ml-auto" method="post" action="/admin/logout">
				<button class="font-mono text-meta bg-transparent border-0 text-dim cursor-pointer p-0 underline underline-offset-2 hover:text-danger" type="submit">Sign out</button>
			</form>
		</div>
	</div>
}

func current(active bool) templ.Attributes {
	if active {
		return templ.Attributes{"aria-current": "page"}
	}
	return templ.Attributes{}
}

func bodyClass(p Page) string {
	if p.IsAdmin {
		return "is-admin flex flex-col h-full"
	}
	return "flex flex-col h-full"
}

func profileClass(p Page) string {
	if p.ProfileOpen {
		return "profile-open"
	}
	return ""
}

func profileExpanded(p Page) string {
	if p.ProfileOpen {
		return "true"
	}
	return "false"
}

func profilePanelAttrs(p Page) templ.Attributes {
	if p.ProfileOpen {
		return templ.Attributes{"aria-hidden": "false"}
	}
	return templ.Attributes{"aria-hidden": "true", "inert": ""}
}

func themePressed(p Page, theme string) string {
	if p.ThemeAttr() == theme {
		return "true"
	}
	return "false"
}

func themeOptions() []string {
	return []string{"default", "light", "green", "dark-green", "blueish-2"}
}
