package ui

import "github.com/mattbx/mattbx-go/internal/ui/static"

// Layout is the site shell.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.DocumentTitle() }</title>
			if p.Description != "" {
				<meta name="description" content={ p.Description }/>
				<meta property="og:description" content={ p.Description }/>
			}
			<meta property="og:title" content={ p.DocumentTitle() }/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content={ p.CanonicalURL() }/>
			<link rel="canonical" href={ templ.SafeURL(p.CanonicalURL()) }/>
			<link rel="alternate" type="application/rss+xml" title={ SiteName } href="/feed.xml"/>
			<link rel="alternate" type="application/feed+json" title={ SiteName } href="/feed.json"/>
			<link rel="micropub" href={ templ.SafeURL(p.BaseURL + "/micropub") }/>
			<link rel="icon" href={ static.URL("favicon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ static.URL("main.css") }/>
			<link rel="stylesheet" href={ static.URL("chroma.css") }/>
			<link rel="stylesheet" href={ static.URL("tailwind.css") }/>
			<script src={ static.URL("terminal.js") } defer></script>
			<script src={ static.URL("cursor.js") } defer></script>
		</head>
		<body class={ bodyClass(p) }>
			<canvas class="grain" aria-hidden="true"></canvas>
			@CornerCrosses()
			<a class={ classSkipLink } href="#main">Skip to content</a>
			if p.IsAdmin {
				@adminBar()
			}
			<header class="site-header py-4 fixed top-0 left-0 right-0 z-10">
				<div class="max-w-site w-full mx-auto px-gutter flex items-center justify-between">
					<a class="wordmark font-ui text-nav tracking-tight font-semibold text-fg no-underline" href="/">{ SiteMark }</a>
					<div class="hidden md:block">@MetaClock()</div>
					
					<nav class="nav font-mono uppercase text-nav text-fg flex gap-6" aria-label="Primary">
						<a class="hover-underline" data-scramble="link" href="/blog" { current(p.Nav == "blog")... }>Posts</a>
						<a class="hover-underline" data-scramble="link" href="/about" { current(p.Nav == "about")... }>About</a>
						<a class="is-locked hover-underline" data-scramble="link" href="/portfolio" { current(p.Nav == "portfolio")... }>Portfolio</a>
					</nav>
				</div>
			</header>
			<main class="flex-1 pt-24 md:pt-32 lg:pt-40 flex flex-col h-full max-w-site w-full mx-auto px-gutter" id="main">
				{ children... }
			</main>
			<footer class="mt-24 max-w-site px-gutter mx-auto pt-6 pb-6 font-mono uppercase text-nav flex flex-wrap gap-6 justify-between">
				<span>© { p.Year() } { SiteName }</span>
				<span>
					<a class="hover-underline" data-scramble="link" href="/feed.xml">Atom feed</a>
					{ " · " }
					<a class="hover-underline" data-scramble="link" href="/feed.json">JSON feed</a>
					{ " · " }
					<a class="hover-underline" href="https://micropub.spec.indieweb.org/">Micropub enabled</a>
				</span>
				<div class="w-full mt-4 pt-4 border-t border-line">
					@MetaRow()
				</div>
			</footer>
		</body>
	</html>
}

// Admin write-access bar.
templ adminBar() {
	<div class="admin-bar font-mono text-meta bg-surface border-b border-line py-2">
		<div class="w-full px-gutter flex flex-wrap items-center gap-6">
			<a href="/admin">Admin</a>
			<a href="/admin/posts/new">New post</a>
			<a href="/admin/projects/new">New project</a>
			<form class="ml-auto" method="post" action="/admin/logout">
				<button class="font-mono text-meta bg-transparent border-0 text-dim cursor-pointer p-0 underline underline-offset-2 hover:text-danger" type="submit">Sign out</button>
			</form>
		</div>
	</div>
}

func current(active bool) templ.Attributes {
	if active {
		return templ.Attributes{"aria-current": "page"}
	}
	return templ.Attributes{}
}

func bodyClass(p Page) string {
	if p.IsAdmin {
		return "is-admin flex flex-col justify-between min-h-screen"
	}
	return "flex flex-col justify-between min-h-screen"
}
