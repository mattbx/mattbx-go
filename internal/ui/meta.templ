package ui

import (
	"strings"
	"time"
)

// Colophon-style readouts. Each piece is usable alone; MetaRow is one layout.

templ metaField(label string) {
	<span class="inline-flex items-baseline gap-2 font-mono text-nav uppercase tracking-wide whitespace-nowrap">
		if label != "" {
			<span class="text-fg">{ label }:</span>
		}
		{ children... }
	</span>
}

// Site clock (data-tz); terminal.js ticks it.
templ MetaClock() {
	@metaField("Local Time") {
		<time class="text-fg" data-meta="clock" data-tz={ SiteTimeZone } datetime={ localDateTime(time.Now()) }>
			{ localTime(time.Now()) }
		</time>
	}
}

// City-level lon/lat, not a precise pin.
templ MetaCoordinates() {
	@metaField("Coordinates") {
		<span class="text-fg">{ SiteCoordinates }</span>
	}
}

// Live UTC offsets (DST-safe).
templ MetaOffsets() {
	@metaField("Global") {
		<span class="text-fg">{ strings.Join(offsetLabels(), ", ") }</span>
	}
}

// Process uptime from data-started; terminal.js ticks it.
templ MetaUptime() {
	@metaField("Uptime") {
		<span class="text-fg" data-meta="uptime" data-started={ processStartUnix() }>
			{ uptimeLabel() }
		</span>
	}
}

// Image build stamp (internal/build + Dockerfile ldflags).
templ MetaBuild() {
	@metaField("Build") {
		<span class="text-fg">{ buildLabel() }</span>
	}
}

// Tab open time; client-only.
templ MetaScreenTime() {
	@metaField("Screen Time") {
		<span class="text-fg" data-meta="screentime">00:00</span>
	}
}

templ MetaRow() {
	<div class="flex flex-wrap justify-between gap-x-6 gap-y-2 w-full">
		@MetaClock()
		@MetaCoordinates()
		@MetaOffsets()
		@MetaUptime()
		@MetaBuild()
		@MetaScreenTime()
	</div>
}
