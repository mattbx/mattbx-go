const (
	typeSampleShort = "Work & Other Things 0123"
	typeSampleLong  = "Type is where the hierarchy lives: a title should read first, the summary second, and the body should hold up over a long scroll without tiring the eye."
)

// TypeSpecimenMarkdown is the in-context post on /admin/type: every element
// a post body uses, rendered through the real markdown pipeline.
const TypeSpecimenMarkdown = "This is the lead paragraph. It sets up the post in a sentence or two, and links to [the front page](/) along the way.\n\n" +
	"## A second-level heading\n\n" +
	"A paragraph under the heading. It runs long enough to wrap at phone width, so line height and measure both show.\n\n" +
	"A second paragraph straight after the first, with `inline code` in the middle of it.\n\n" +
	"A third paragraph in a row, to show the rhythm of plain running text across several blocks.\n\n" +
	"A paragraph followed by a list:\n\n" +
	"- First unordered item\n- Second unordered item, a little longer so it wraps at narrow widths\n- Third item\n\n" +
	"### A third-level heading\n\n" +
	"1. Ordered one\n2. Ordered two\n3. Ordered three\n\n" +
	"#### A fourth-level heading\n\n" +
	"> A blockquote. Short, set off from the text around it.\n\n" +
	"```go\nfunc main() {\n\tfmt.Println(\"hello, type\")\n}\n```\n\n" +
	"A closing paragraph after the code block."

func samplePostRow(title string) *db.Post {
	return &db.Post{
		Title:       title,
		Slug:        "type-specimen",
		Published:   true,
		PublishedAt: sql.NullTime{Time: time.Date(2026, 11, 8, 0, 0, 0, 0, time.UTC), Valid: true},
	}
}

func sampleProjectRow(title string) *db.Project {
	return &db.Project{Title: title, Slug: "type-specimen", Role: "Ref. A/001", Tech: "Web", SortOrder: 1, Published: true}
}

// TypeSpecimen is /admin/type: every type role with live computed values
// (filled in by typespec.js), then a full post in context.
templ TypeSpecimen(p Page, post *db.Post) {
	@Layout(p) {
		<div class={ classPageHead }>
			<p class={ classEyebrow }>Admin</p>
			<h1 class={ classPageTitle }>Type specimen</h1>
			<p class={ classPageLede }>
				Every role in internal/ui/tailwind/typography.css, with values read live from the browser. Edit the file, rebuild, refresh.
			</p>
		</div>
		<p class="type-meta text-danger" data-type-missing hidden></p>
		for _, g := range typeGroups {
			<section class="mt-10">
				<h2 class="type-eyebrow text-dim m-0 mb-2">{ g.Title }</h2>
				for _, r := range g.Roles {
					<div class="border-t border-line py-24" data-type-row data-type-target={ r.Target } data-type-use={ r.Use }>
						<p class="type-meta text-fg m-0">{ r.Name } <span class="text-dim">{ r.Use }</span></p>
						<p class="type-meta text-dim m-0 mb-2" data-type-values>-</p>
						<div data-type-short>
							@typeSample(r, typeSampleShort)
						</div>
						<div class="mt-2">
							@typeSample(r, typeSampleLong)
						</div>
					</div>
				}
			</section>
		}
		<section class="mt-10">
			<h2 class="type-eyebrow text-dim m-0 mb-2">Post in context - real post markup and prose styles</h2>
			<div class="border-t border-line py-24">
				@postArticle(p, post)
			</div>
		</section>
		<section class="mt-10">
			<h2 class="type-eyebrow text-dim m-0 mb-2">Tokens - every type custom property, as the browser resolves it</h2>
			<div class="type-meta border-t border-line py-24" data-type-tokens></div>
		</section>
	}
}

templ typeSample(r TypeRole, text string) {
	switch r.Kind {
		case "recipe", "class":
			<p class={ r.Class, "m-0" }>{ text }</p>
		case "plain":
			<p class="m-0">{ text }</p>
		case "prose":
			<div class="prose">
				switch r.Tag {
					case "h1":
						<h1>{ text }</h1>
					case "h2":
						<h2>{ text }</h2>
					case "h3":
						<h3>{ text }</h3>
					case "h4":
						<h4>{ text }</h4>
					case "code":
						<p>Inline <code>{ text }</code> in a sentence.</p>
					case "pre":
						<pre><code>{ text }</code></pre>
					case "blockquote":
						<blockquote><p>{ text }</p></blockquote>
					case "th", "td":
						<table>
							<thead><tr><th>{ text }</th></tr></thead>
							<tbody><tr><td>{ text }</td></tr></tbody>
						</table>
					default:
						<p>{ text }</p>
				}
			</div>
		case "rail":
			<div class="rail">
				if r.Tag == "key" {
					<span class="rail__key">{ text }</span>
				} else {
					<span class="rail__line">
						<span class="rail__key">Published</span>
						<span class="rail__value">{ text }</span>
					</span>
				}
			</div>
		case "ledger":
			<ol class="ledger">
				if r.Tag == "blog" {
					@postEntry(samplePostRow(text))
				} else {
					@workEntry(sampleProjectRow(text), false)
				}
			</ol>
		case "resume":
			<div class="type-resume text-dim">
				switch r.Tag {
					case "links":
						<p class="profile-panel__links m-0"><a class="hover-underline" href="#">{ text }</a></p>
					case "heading":
						<section class="profile-panel__section"><h2 class="profile-panel__heading">{ text }</h2></section>
					default:
						<section class="profile-panel__section"><h3>{ text }</h3></section>
				}
			</div>
		case "field":
			switch r.Tag {
				case "input":
					<input class="input" type="text" value={ text } aria-label={ r.Name }/>
				case "textarea":
					<textarea class="textarea textarea--short" aria-label={ r.Name }>{ text }</textarea>
				case "checkline":
					<label class="checkline"><input type="checkbox"/>{ text }</label>
				default:
					<button class="button" type="button">{ text }</button>
			}
	}
}
