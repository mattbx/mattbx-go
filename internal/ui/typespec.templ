package ui

import (
	"database/sql"
	"time"

	"github.com/mattbx/mattbx-go/internal/db"
)

// TypeRole is one row on /admin/type. Use is what to reach for (a recipe
// class, or the token a main.css component reads). Kind picks the sample
// markup; Target is the element inside the sample whose computed values
// typespec.js reads.
type TypeRole struct {
	Name   string
	Use    string
	Kind   string // recipe | plain | prose | class | rail | field | resume | ledger
	Tag    string // element or variant within Kind
	Class  string
	Target string
}

type TypeGroup struct {
	Title string
	Roles []TypeRole
}

// typeGroups lists every role in tailwind/typography.css. Add a row here when
// you add a role; the page warns about recipes it finds in the CSS but not here.
var typeGroups = []TypeGroup{
	{"Recipes - templates use these classes", []TypeRole{
		{Name: "display", Use: "type-display", Kind: "recipe", Class: "type-display", Target: "p"},
		{Name: "wordmark", Use: "type-wordmark", Kind: "recipe", Class: "type-wordmark", Target: "p"},
